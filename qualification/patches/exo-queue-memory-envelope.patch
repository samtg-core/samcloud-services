diff --git a/src/exo/utils/staged_rank.py b/src/exo/utils/staged_rank.py
index 96bc3ee..2bdea3f 100644
--- a/src/exo/utils/staged_rank.py
+++ b/src/exo/utils/staged_rank.py
@@ -87,0 +88,14 @@ class StagedRank:
+@dataclass(frozen=True)
+class RankMemory:
+    name: str
+    layers: tuple[int, int]
+    weights_bytes: int
+    kv_bytes: int
+
+    @property
+    def minimum_bytes(self) -> int:
+        # Excludes allocator, loading/prefill workspace and process overhead.
+        # This is a lower-bound refusal, never a measured residency verdict.
+        return self.weights_bytes + self.kv_bytes
+
+
@@ -259,0 +274,52 @@ def verify_rank_bytes(rank: StagedRank) -> None:
+def read_staged_memory(
+    model_id: str, context_length: int, environment: Mapping[str, str]
+) -> tuple[RankMemory, ...]:
+    """Pinned assigned weights plus the full F16 GQA cache, without MLX.
+
+    Reuse the real staged-rank checks, including the local loading view. The
+    exact manifest and parent pins bind every rank's layer range and file size.
+    Full weight hashes remain the loader's separate one-time prerequisite.
+    """
+    if read_staged_rank(model_id, environment) is None:
+        raise ValueError("explicit staged-rank profile required for queue envelopes")
+    root = Path(environment["EXO_RANK_BUNDLE"])
+    raw = _read_metadata(root / "rank-bundle.json")
+    if hashlib.sha256(raw).hexdigest() != environment["EXO_RANK_MANIFEST_SHA256"]:
+        raise ValueError("rank manifest changed during capacity validation")
+    manifest = _Bundle.model_validate_json(raw)
+    parent = _OBJECT.validate_json(_read_metadata(root / "parent-manifest.json"))
+    if _object_digest(parent) != manifest.parent_manifest_sha256:
+        raise ValueError("rank parent changed during capacity validation")
+    config = parent.get("config")
+    if not isinstance(config, dict):
+        raise ValueError("pinned Qwen3 cache geometry required")
+
+    def positive(name: str) -> int:
+        value = config.get(name)
+        if type(value) is not int or value <= 0:
+            raise ValueError("positive pinned Qwen3 cache geometry required: " + name)
+        return value
+
+    maximum = positive("max_position_embeddings")
+    heads = positive("num_key_value_heads")
+    if "head_dim" in config:
+        dimension = positive("head_dim")
+    else:
+        hidden, attention = positive("hidden_size"), positive("num_attention_heads")
+        if hidden % attention:
+            raise ValueError("integral pinned Qwen3 head dimension required")
+        dimension = hidden // attention
+    if type(context_length) is not int or not 0 < context_length <= maximum:
+        raise ValueError("served context exceeds the pinned native window")
+    per_layer = context_length * heads * dimension * 2 * 2  # keys+values, F16
+    return tuple(
+        RankMemory(
+            rank.name,
+            rank.layers,
+            rank.expected_bytes,
+            (rank.layers[1] - rank.layers[0]) * per_layer,
+        )
+        for rank in manifest.ranks
+    )
+
+
