@@ -0,0 +1,224 @@
+"""Real instance and rank metadata; no model, process, sockets or allocation."""
+
+import hashlib
+import json
+from dataclasses import replace
+from pathlib import Path
+from unittest.mock import AsyncMock
+
+import pytest
+from fastapi import HTTPException
+
+from exo.api.main import API
+from exo.api.types.api import CreateInstanceParams
+from exo.shared.models.model_cards import ModelCard, ModelTask
+from exo.shared.types.backends import Backend
+from exo.shared.types.common import Host, ModelId, NodeId
+from exo.shared.types.memory import Memory
+from exo.shared.types.worker.instances import InstanceId, MlxRingInstance
+from exo.shared.types.worker.runners import RunnerId, ShardAssignments
+from exo.shared.types.worker.shards import PipelineShardMetadata
+from exo.utils.leased_instance import pinned_instance_card
+from exo.utils.leased_runtime import LeasedRuntimeProfile
+from exo.utils.staged_rank import read_staged_memory
+
+
+def encoded(value: object) -> bytes:
+    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+
+
+def digest(value: object) -> str:
+    return hashlib.sha256(encoded(value)).hexdigest()
+
+
+@pytest.fixture
+def leased(tmp_path: Path) -> tuple[LeasedRuntimeProfile, CreateInstanceParams]:
+    config = {
+        "model_type": "qwen3",
+        "num_hidden_layers": 4,
+        "num_key_value_heads": 1,
+        "head_dim": 2,
+        "max_position_embeddings": 65536,
+    }
+    records: list[dict[str, object]] = []
+    sidecars: list[dict[str, object]] = []
+    for number, name in enumerate(("slice", "obelisk")):
+        directory = tmp_path / name
+        directory.mkdir()
+        names = [f"model.layers.{number * 2 + i}.weight" for i in range(2)]
+        names += ["model.embed_tokens.weight", "model.norm.weight", "lm_head.weight"]
+        raw = encoded(
+            {
+                n: {"dtype": "U8", "shape": [4], "data_offsets": [i * 4, (i + 1) * 4]}
+                for i, n in enumerate(names)
+            }
+        )
+        raw += b" " * (-len(raw) % 8)
+        weights = len(raw).to_bytes(8, "little") + raw + b"abcd" * len(names)
+        (directory / "rank.safetensors").write_bytes(weights)
+        (directory / "model-rank.safetensors").symlink_to("rank.safetensors")
+        sidecars = []
+        for filename, value in (
+            ("config.json", encoded(config)),
+            ("tokenizer.json", b"{}"),
+            ("tokenizer_config.json", b"{}"),
+        ):
+            (directory / filename).write_bytes(value)
+            sidecars.append(
+                {
+                    "name": filename,
+                    "bytes": len(value),
+                    "sha256": hashlib.sha256(value).hexdigest(),
+                }
+            )
+        records.append(
+            {
+                "name": name,
+                "layers": [number * 2, number * 2 + 2],
+                "file": f"{name}/rank.safetensors",
+                "required_tensor_names": names,
+                "expected_bytes": len(weights),
+                "sha256": hashlib.sha256(weights).hexdigest(),
+            }
+        )
+    parent = {
+        "model_id": "fixture/qwen3",
+        "revision": "a" * 40,
+        "config": config,
+        "sidecar_files": sidecars,
+    }
+    manifest = {
+        "format": "samcloud-qwen3-rank-staging-v1",
+        "model_id": "fixture/qwen3",
+        "revision": "a" * 40,
+        "parent_manifest_sha256": digest(parent),
+        "parent_index_sha256": "b" * 64,
+        "config_sha256": digest(config),
+        "rank_policy": "assigned_layers_plus_all_nonlayers",
+        "ranks": records,
+        "loader_status": "requires_qualified_shard_aware_adapter",
+    }
+    (tmp_path / "parent-manifest.json").write_bytes(encoded(parent))
+    (tmp_path / "rank-bundle.json").write_bytes(encoded(manifest))
+    (tmp_path / "VERIFIED").write_text(digest(manifest))
+    profile = LeasedRuntimeProfile(
+        "group_" + "a" * 24,
+        1,
+        "slice",
+        digest(manifest),
+        tmp_path,
+        tmp_path,
+        ("192.168.50.11", "192.168.50.13"),
+        tmp_path / "key",
+        53515,
+        53514,
+        53513,
+        53516,
+        memory_mb=(2, 2),
+    )
+    card = ModelCard(
+        model_id=ModelId("fixture/qwen3"),
+        storage_size=Memory.from_bytes(1000),
+        n_layers=4,
+        hidden_size=8,
+        supports_tensor=False,
+        num_key_value_heads=1,
+        tasks=[ModelTask.TextGeneration],
+        family="qwen3",
+        context_length=65536,
+        trust_remote_code=False,
+        backends=[Backend.MlxMetal],
+    )
+
+    def identity(name: str) -> str:
+        return digest(
+            [profile.group_id, profile.generation, profile.manifest_sha256, name]
+        )
+
+    runners = tuple(RunnerId(identity("runner:" + n)) for n in profile.ranks)
+    nodes = (NodeId("1"), NodeId("2"))
+    instance = MlxRingInstance(
+        instance_id=InstanceId(identity("instance")),
+        ephemeral_port=53516,
+        shard_assignments=ShardAssignments(
+            model_id=card.model_id,
+            node_to_runner=dict(zip(nodes, runners, strict=True)),
+            runner_to_shard={
+                runner: PipelineShardMetadata(
+                    model_card=card,
+                    device_rank=i,
+                    world_size=2,
+                    start_layer=i * 2,
+                    end_layer=i * 2 + 2,
+                    n_layers=4,
+                )
+                for i, runner in enumerate(runners)
+            },
+        ),
+        hosts_by_node={
+            n: [Host(ip=ip, port=53516) for ip in profile.peer_ips] for n in nodes
+        },
+    )
+    return profile, CreateInstanceParams(instance=instance)
+
+
+async def test_queue_placement_creates_once_even_when_discovery_free_ram_is_zero(
+    leased: tuple[LeasedRuntimeProfile, CreateInstanceParams],
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    profile, request = leased
+    api = object.__new__(API)
+    sent = AsyncMock()
+    monkeypatch.setattr(api, "_leased_profile", profile, raising=False)
+    monkeypatch.setattr(api, "_send", sent)
+    monkeypatch.setattr(api, "_calculate_total_available_memory", lambda: Memory())
+    response = await api.create_instance(request)
+    assert response.model_card.model_id == ModelId("fixture/qwen3")
+    sent.assert_awaited_once()
+
+
+async def test_legacy_leased_profile_keeps_the_existing_free_memory_guard(
+    leased: tuple[LeasedRuntimeProfile, CreateInstanceParams],
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    profile, request = leased
+    api = object.__new__(API)
+    sent = AsyncMock()
+    monkeypatch.setattr(
+        api, "_leased_profile", replace(profile, memory_mb=None), raising=False
+    )
+    monkeypatch.setattr(api, "_send", sent)
+    monkeypatch.setattr(api, "_calculate_total_available_memory", lambda: Memory())
+    with pytest.raises(HTTPException, match="Insufficient memory"):
+        await api.create_instance(request)
+    sent.assert_not_awaited()
+
+
+@pytest.mark.parametrize(
+    "budgets", [(100, 1), (1, 100), (2,), (2, 2, 2), (2, 0), (True, 2)]
+)
+def test_each_rank_needs_its_own_full_cache_not_spare_memory_on_another_host(
+    leased: tuple[LeasedRuntimeProfile, CreateInstanceParams], budgets: tuple[int, ...]
+) -> None:
+    profile, request = leased
+    with pytest.raises(ValueError, match="envelope"):
+        pinned_instance_card(replace(profile, memory_mb=budgets), request.instance)
+
+
+def test_full_window_cache_and_assigned_file_bytes_are_used(
+    leased: tuple[LeasedRuntimeProfile, CreateInstanceParams],
+) -> None:
+    profile, _ = leased
+    environment = {
+        "EXO_RANK_BUNDLE": str(profile.model_bundle),
+        "EXO_RANK_MANIFEST_SHA256": profile.manifest_sha256,
+        "EXO_RANK_NAME": profile.rank,
+    }
+    needed = read_staged_memory("fixture/qwen3", 65536, environment)
+    assert tuple(n.layers for n in needed) == ((0, 2), (2, 4))
+    assert all(n.kv_bytes == 1048576 and n.minimum_bytes > n.kv_bytes for n in needed)
+    with pytest.raises(ValueError, match="native window"):
+        read_staged_memory("fixture/qwen3", 65537, environment)
+    (profile.model_bundle / "parent-manifest.json").write_text("{}")
+    with pytest.raises(ValueError, match="parent"):
+        read_staged_memory("fixture/qwen3", 65536, environment)
