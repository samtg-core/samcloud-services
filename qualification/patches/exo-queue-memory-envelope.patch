@@ -82,0 +84,25 @@ def pinned_instance_card(
+    if profile.memory_mb is not None:
+        requirements = read_staged_memory(
+            str(card.model_id),
+            card.context_length,
+            {
+                "EXO_RANK_BUNDLE": str(profile.model_bundle),
+                "EXO_RANK_MANIFEST_SHA256": profile.manifest_sha256,
+                "EXO_RANK_NAME": profile.rank,
+            },
+        )
+        if len(requirements) != len(names) or len(profile.memory_mb) != len(names):
+            raise ValueError("queue envelopes differ from the pinned pipeline")
+        for name, (_, shard), needed, memory_mb in zip(
+            names, ordered, requirements, profile.memory_mb, strict=True
+        ):
+            if (
+                needed.name != name
+                or needed.layers != (shard.start_layer, shard.end_layer)
+                or type(memory_mb) is not int
+                or memory_mb <= 0
+                or needed.minimum_bytes > memory_mb * 1024 * 1024
+            ):
+                raise ValueError(
+                    "assigned weights and full cache exceed the exact queue envelope"
+                )
