+def test_leased_state_retains_task_authority_without_generation_payload(
+    leased: tuple[LeasedRuntimeProfile, CreateInstanceParams],
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    from exo.shared.types.common import CommandId
+    from exo.shared.types.state import State
+    from exo.shared.types.tasks import TaskStatus, TextGeneration
+    from exo.shared.types.text_generation import TextGenerationTaskParams
+
+    profile, _ = leased
+    task = TextGeneration(
+        command_id=CommandId(),
+        instance_id=InstanceId(),
+        task_status=TaskStatus.Running,
+        task_params=TextGenerationTaskParams(
+            model=ModelId("test"), input=[], tools=[{"description": "X" * 160000}]
+        ),
+    )
+    api = object.__new__(API)
+    monkeypatch.setattr(api, "_leased_profile", profile, raising=False)
+    api.state = State(tasks={task.task_id: task}, last_event_applied_idx=19)
+    assert len(api.state.model_dump_json()) > 128 * 1024
+    response = api.leased_state()
+    state = cast(dict[str, object], json.loads(bytes(response.body)))
+    assert len(response.body) < 128 * 1024
+    assert state["tasks"] == {
+        task.task_id: {
+            "TextGeneration": {
+                "taskId": task.task_id,
+                "instanceId": task.instance_id,
+                "taskStatus": "Running",
+            }
+        }
+    }
+    assert state["lastEventAppliedIdx"] == 19
+    full = api.state.model_dump(mode="json", by_alias=True)
+    for key in (
+        "instances",
+        "runners",
+        "downloads",
+        "topology",
+        "prefillServerPorts",
+        "instanceLinks",
+    ):
+        assert state[key] == full[key]
+    monkeypatch.setattr(api, "_leased_profile", None)
+    with pytest.raises(HTTPException) as exc:
+        api.leased_state()
+    assert exc.value.status_code == 404
