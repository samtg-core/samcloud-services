+    def leased_state(self) -> JSONResponse:
+        if self._leased_profile is None:
+            raise HTTPException(status_code=404, detail="Private state unavailable")
+        # Use one immutable event snapshot. Retained task inputs can exceed
+        # the coordinator's metadata budget even for a single healthy call.
+        state = self.state
+        result = state.model_dump(
+            mode="json",
+            by_alias=True,
+            include={
+                "instances",
+                "runners",
+                "downloads",
+                "topology",
+                "last_event_applied_idx",
+                "prefill_server_ports",
+                "instance_links",
+            },
+        )
+        result["tasks"] = {
+            key: task.model_dump(
+                mode="json",
+                by_alias=True,
+                include={"task_id", "instance_id", "task_status"},
+            )
+            for key, task in state.tasks.items()
+        }
+        return JSONResponse(result)
+
