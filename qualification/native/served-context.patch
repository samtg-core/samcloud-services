@@ -0,0 +1,32 @@
+"""Explicit served token budgets for pinned workers; no ordinary default cap."""
+
+import os
+import re
+from collections.abc import Mapping
+
+
+def validate_served_token_budget(
+    prompt_tokens: int,
+    output_tokens: int,
+    environment: Mapping[str, str] | None = None,
+) -> None:
+    """Count the whole encoded prompt, including any cached prefix.
+
+    A profile is an explicit install-time control. Refuse an over-budget request
+    before cache creation or prefill rather than truncating its input or output.
+    """
+    environment = os.environ if environment is None else environment
+    raw = environment.get("EXO_SERVED_CONTEXT_LENGTH")
+    if raw is None:
+        return
+    if not re.fullmatch(r"[1-9][0-9]*", raw):
+        raise ValueError("EXO_SERVED_CONTEXT_LENGTH must be a positive decimal integer")
+    if (
+        type(prompt_tokens) is not int
+        or prompt_tokens < 0
+        or type(output_tokens) is not int
+        or output_tokens < 1
+    ):
+        raise ValueError("explicit served context requires a valid token budget")
+    if prompt_tokens + output_tokens > int(raw):
+        raise ValueError("request token budget exceeds the configured served context")
diff --git a/src/exo/utils/tests/test_served_context.py b/src/exo/utils/tests/test_served_context.py
new file mode 100644
index 0000000..ace692a
--- /dev/null
+++ b/src/exo/utils/tests/test_served_context.py
@@ -0,0 +1,30 @@
+import pytest
+
+from exo.utils.served_context import validate_served_token_budget
+
+
+def test_ordinary_profile_has_no_new_default_cap() -> None:
+    validate_served_token_budget(262144, 32768, {})
+
+
+def test_exact_whole_prompt_and_output_budget_fits() -> None:
+    validate_served_token_budget(49152, 16384, {"EXO_SERVED_CONTEXT_LENGTH": "65536"})
+
+
+def test_one_token_past_profile_refuses_without_silent_truncation() -> None:
+    with pytest.raises(ValueError, match="exceeds the configured served context"):
+        validate_served_token_budget(
+            49153, 16384, {"EXO_SERVED_CONTEXT_LENGTH": "65536"}
+        )
+
+
+@pytest.mark.parametrize("value", ["", "0", "-1", "1.5", " 65536", "false", "065536"])
+def test_invalid_explicit_window_never_falls_back(value: str) -> None:
+    with pytest.raises(ValueError, match="positive decimal integer"):
+        validate_served_token_budget(1, 1, {"EXO_SERVED_CONTEXT_LENGTH": value})
+
+
+@pytest.mark.parametrize("counts", [(-1, 1), (1, 0), (1, -1), (True, 1)])
+def test_configured_budget_cannot_hide_invalid_counts(counts: tuple[int, int]) -> None:
+    with pytest.raises(ValueError, match="valid token budget"):
+        validate_served_token_budget(*counts, {"EXO_SERVED_CONTEXT_LENGTH": "65536"})
