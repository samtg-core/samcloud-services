diff --git a/src/exo/worker/tests/unittests/test_mlx/test_served_context_boundary.py b/src/exo/worker/tests/unittests/test_mlx/test_served_context_boundary.py
new file mode 100644
index 0000000..9a560df
--- /dev/null
+++ b/src/exo/worker/tests/unittests/test_mlx/test_served_context_boundary.py
@@ -0,0 +1,50 @@
+"""An over-budget full prompt never consults a cached suffix or runs a model."""
+
+from typing import cast
+from unittest.mock import Mock, patch
+
+import pytest
+from mlx_lm.tokenizer_utils import TokenizerWrapper
+
+from exo.shared.types.common import ModelId
+from exo.shared.types.text_generation import TextGenerationTaskParams
+from exo.worker.engines.mlx.cache import KVPrefixCache
+from exo.worker.engines.mlx.generator import generate
+from exo.worker.engines.mlx.types import Model
+
+
+def test_full_prompt_budget_refuses_before_cache_lookup_or_prefill(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setenv("EXO_SERVED_CONTEXT_LENGTH", "32")
+    model = Mock(side_effect=AssertionError("model execution forbidden"))
+    cache_lookup = Mock()
+    cache = Mock(get_kv_cache=cache_lookup)
+    task = TextGenerationTaskParams(
+        model=ModelId("qualification/qwen3"), input=[], max_output_tokens=16
+    )
+    # Only len() is reached; no MLX arrays, arithmetic or model are constructed.
+    prompt = list(range(17))
+    with (
+        patch.object(generate.mx, "reset_peak_memory"),
+        patch.object(generate.mx.random, "seed"),
+        patch.object(generate, "encode_prompt", return_value=prompt),
+        patch.object(generate, "fix_unmatched_think_end_tokens", return_value=prompt),
+        patch.object(generate, "system_prompt_token_count", return_value=0),
+        patch.object(generate, "make_kv_cache") as create_cache,
+        patch.object(generate, "prefill") as prefill,
+    ):
+        result = generate.mlx_generate(
+            cast(Model, model),
+            cast(TokenizerWrapper, Mock()),
+            task,
+            "input",
+            cast(KVPrefixCache, cache),
+            None,
+        )
+        with pytest.raises(ValueError, match="exceeds the configured served context"):
+            next(result)
+        create_cache.assert_not_called()
+        prefill.assert_not_called()
+    model.assert_not_called()
+    cache_lookup.assert_not_called()
diff --git a/src/exo/worker/tests/unittests/test_mlx/test_served_context_runner.py b/src/exo/worker/tests/unittests/test_mlx/test_served_context_runner.py
